{
  "manifest_version": 3,
  "name": "Resume One",
  "version": "1.0",
  "description": "Captures tabs for Resume One app",
"host_permissions": ["<all_urls>"],
  "permissions": ["tabs", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type":"module"
  },
  "action": {
    "default_title": "Send tabs to Resume One"
  }
}